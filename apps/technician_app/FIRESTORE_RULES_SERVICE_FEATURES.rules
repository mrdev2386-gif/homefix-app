// Firestore Security Rules for Service-Level Features
// Add these rules to your firestore.rules file

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Services collection with new feature validation
    match /services/{serviceId} {
      // Allow technician to read their own services
      allow read: if request.auth != null && 
                     resource.data.technicianId == request.auth.uid;
      
      // Allow technician to create services
      allow create: if request.auth != null &&
                       request.resource.data.technicianId == request.auth.uid &&
                       validateServiceData(request.resource.data);
      
      // Allow technician to update their own services
      allow update: if request.auth != null &&
                       resource.data.technicianId == request.auth.uid &&
                       validateServiceData(request.resource.data);
      
      // Allow technician to delete their own services
      allow delete: if request.auth != null &&
                       resource.data.technicianId == request.auth.uid;
    }
    
    // Helper function to validate service data
    function validateServiceData(data) {
      return data.name is string &&
             data.name.size() >= 3 &&
             data.basePrice is number &&
             data.basePrice > 0 &&
             data.technicianId is string &&
             data.categoryId is string &&
             validateUrgentBooking(data.get('urgentBooking', null)) &&
             validateNightService(data.get('nightService', null));
    }
    
    // Validate urgent booking configuration
    function validateUrgentBooking(urgentBooking) {
      return urgentBooking == null ||
             (urgentBooking is map &&
              urgentBooking.enabled is bool &&
              (urgentBooking.enabled == false ||
               (urgentBooking.arrivalTime in ['30-60min', '1-2hours', '2-3hours'] &&
                urgentBooking.urgentFee in [50, 100, 150, 200, 250, 300])));
    }
    
    // Validate night service configuration
    function validateNightService(nightService) {
      return nightService == null ||
             (nightService is map &&
              nightService.enabled is bool &&
              (nightService.enabled == false ||
               nightService.nightCharge in [0, 50, 100, 150, 200]));
    }
    
  }
}

// ============================================
// VALIDATION RULES SUMMARY
// ============================================

/*
URGENT BOOKING VALIDATION:
- If enabled: true
  - arrivalTime MUST be one of: "30-60min", "1-2hours", "2-3hours"
  - urgentFee MUST be one of: 50, 100, 150, 200, 250, 300
- If enabled: false
  - arrivalTime and urgentFee can be null or any value (ignored)

NIGHT SERVICE VALIDATION:
- If enabled: true
  - nightCharge MUST be one of: 0, 50, 100, 150, 200
- If enabled: false
  - nightCharge can be null or any value (ignored)

GENERAL SERVICE VALIDATION:
- name: string, minimum 3 characters
- basePrice: number, must be > 0
- technicianId: string, must match authenticated user
- categoryId: string, required
- urgentBooking: optional map, must pass validation if present
- nightService: optional map, must pass validation if present
*/

// ============================================
// EXAMPLE VALID SERVICE DOCUMENTS
// ============================================

/*
EXAMPLE 1: Service with Urgent Booking Only
{
  "id": "service_123",
  "technicianId": "tech_456",
  "categoryId": "cat_789",
  "name": "AC Repair",
  "basePrice": 600,
  "urgentBooking": {
    "enabled": true,
    "arrivalTime": "1-2hours",
    "urgentFee": 200
  },
  "nightService": {
    "enabled": false
  }
}

EXAMPLE 2: Service with Night Service Only
{
  "id": "service_124",
  "technicianId": "tech_456",
  "categoryId": "cat_789",
  "name": "Plumbing",
  "basePrice": 500,
  "urgentBooking": {
    "enabled": false
  },
  "nightService": {
    "enabled": true,
    "nightCharge": 100
  }
}

EXAMPLE 3: Service with Both Features
{
  "id": "service_125",
  "technicianId": "tech_456",
  "categoryId": "cat_789",
  "name": "Electrical Work",
  "basePrice": 800,
  "urgentBooking": {
    "enabled": true,
    "arrivalTime": "30-60min",
    "urgentFee": 300
  },
  "nightService": {
    "enabled": true,
    "nightCharge": 150
  }
}

EXAMPLE 4: Service with No Features
{
  "id": "service_126",
  "technicianId": "tech_456",
  "categoryId": "cat_789",
  "name": "Cleaning",
  "basePrice": 400,
  "urgentBooking": {
    "enabled": false
  },
  "nightService": {
    "enabled": false
  }
}
*/

// ============================================
// INVALID EXAMPLES (Will be rejected)
// ============================================

/*
INVALID 1: Wrong urgentFee value
{
  "urgentBooking": {
    "enabled": true,
    "arrivalTime": "1-2hours",
    "urgentFee": 175  // ❌ Not in [50, 100, 150, 200, 250, 300]
  }
}

INVALID 2: Wrong arrivalTime value
{
  "urgentBooking": {
    "enabled": true,
    "arrivalTime": "3-4hours",  // ❌ Not in allowed list
    "urgentFee": 200
  }
}

INVALID 3: Wrong nightCharge value
{
  "nightService": {
    "enabled": true,
    "nightCharge": 75  // ❌ Not in [0, 50, 100, 150, 200]
  }
}

INVALID 4: Missing required field when enabled
{
  "urgentBooking": {
    "enabled": true,
    "arrivalTime": "1-2hours"
    // ❌ Missing urgentFee
  }
}

INVALID 5: Wrong data type
{
  "urgentBooking": {
    "enabled": "true",  // ❌ Should be boolean, not string
    "arrivalTime": "1-2hours",
    "urgentFee": 200
  }
}
*/
