{
    "name": "homefix-functions",
    "version": "2.0.0",
    "description": "Cloud Functions for HomeFix - 1st Gen",
    "main": "lib/index.js",
    "scripts": {
        "build": "tsc",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "deploy:v2:batch1": "firebase deploy --only functions:createBooking,functions:initiateRazorpayPayment,functions:verifyRazorpayPayment",
        "deploy:v2:batch2": "firebase deploy --only functions:onBookingCreated,functions:onBookingStatusChange",
        "deploy:v2:batch3": "firebase deploy --only functions:handlePaymentWebhook",
        "logs": "firebase functions:log",
        "lint": "eslint --ext .ts .",
        "test": "npm run build && firebase emulators:exec --only functions 'echo Tests passed'"
    },
    "engines": {
        "node": "20"
    },
    "dependencies": {
        "axios": "^1.6.0",
        "firebase-admin": "^12.0.0",
        "firebase-functions": "^4.9.0",
        "pdfkit": "^0.13.0",
        "razorpay": "^2.9.6"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "firebase-functions-test": "^0.3.3",
        "typescript": "^5.0.0"
    },
    "private": true
}
