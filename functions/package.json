{
  "name": "homefix-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for HomeFix",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint --ext .ts .",
    "test": "npm run build && firebase emulators:exec --only functions 'echo Tests passed'"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "firebase-admin": "^11.11.1",
    "firebase-functions": "^4.4.1",
    "firebase-functions-test": "^0.3.3",
    "pdfkit": "^0.13.0",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.5"
  },
  "private": true
}
