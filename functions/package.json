{
    "name": "homefix-functions",
    "version": "1.0.0",
    "description": "Cloud Functions for HomeFix",
    "main": "lib/index.js",
    "scripts": {
        "build": "tsc",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "engines": {
        "node": "20"
    },
    "dependencies": {
        "axios": "^1.6.0",
        "firebase-admin": "^12.0.0",
        "firebase-functions": "^4.5.0",
        "pdfkit": "^0.13.0",
        "razorpay": "^2.9.6"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "firebase-functions-test": "^3.1.0",
        "typescript": "^5.0.0"
    },
    "private": true
}
