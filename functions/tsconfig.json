{
"compilerOptions": {
"module": "commonjs",
"noImplicitReturns": false,
"noUnusedLocals": false,
"noEmitOnError": false,
"outDir": "lib",
"rootDir": "src",
"sourceMap": true,
"strict": false,
"target": "es2020",
"esModuleInterop": true,
"skipLibCheck": true,
"noImplicitAny": false,
"resolveJsonModule": true
},
"compileOnSave": true,
"include": [
"src"
]
}
