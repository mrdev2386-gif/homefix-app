// Firestore Security Rules for Bank Verification
// Add to firestore.rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /technicians/{technicianId} {
      // Technicians can read their own document
      allow read: if request.auth != null && request.auth.uid == technicianId;
      
      // Technicians can update their profile BUT NOT bank verification fields
      allow update: if request.auth != null 
        && request.auth.uid == technicianId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['bankStatus', 'bankVerifiedAt', 'bankVerificationMessage', 'razorpayFundAccountId']);
      
      // Only Cloud Functions can update bank verification fields
      // (Cloud Functions run with admin privileges, not user auth)
    }
    
    // Wallet collection rules
    match /wallets/{walletId} {
      allow read: if request.auth != null && request.auth.uid == walletId;
      // Wallet updates only via Cloud Functions
      allow write: if false;
    }
    
    // Wallet transactions
    match /wallet_transactions/{transactionId} {
      allow read: if request.auth != null 
        && request.auth.uid == resource.data.technicianId;
      // Transactions created only via Cloud Functions
      allow write: if false;
    }
  }
}
