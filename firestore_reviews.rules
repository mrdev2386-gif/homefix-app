rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reviews Collection
    match /reviews/{reviewId} {
      // Customer can read their own reviews
      allow read: if request.auth.uid == resource.data.customerId;
      
      // Technician can read reviews about themselves
      allow read: if request.auth.uid == resource.data.technicianId;
      
      // Admin can read all reviews
      allow read: if request.auth.token.admin == true;
      
      // No direct writes - only via Cloud Functions
      allow write: if false;
    }

    // Technicians Collection - Read ratings
    match /technicians/{technicianId} {
      allow read: if true;
      allow write: if false;
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if request.auth.uid == resource.data.customerId 
                  || request.auth.uid == resource.data.technicianId;
      allow write: if false;
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read, write: if request.auth.uid == customerId;
    }
  }
}

/*
REQUIRED FIRESTORE INDEXES:

1. Collection: reviews
   Fields: technicianId (Ascending), createdAt (Descending)
   
2. Collection: reviews
   Fields: bookingId (Ascending)
*/
