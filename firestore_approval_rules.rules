rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Technicians collection - enhanced with approval workflow
    match /technicians/{technicianId} {
      allow read: if request.auth != null && request.auth.uid == technicianId;
      allow write: if request.auth != null && request.auth.uid == technicianId
        && validateTechnicianUpdate(resource, request.resource);
      
      // Admin can read all technicians for approval workflow
      allow read: if request.auth != null && isAdmin();
      // Admin can update approval status
      allow update: if request.auth != null && isAdmin() 
        && isApprovalStatusUpdate(resource, request.resource);
    }
    
    // Technician services - strict approval enforcement
    match /technician_services/{serviceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.technicianId
        && isTechnicianApproved(request.auth.uid);
      allow update: if request.auth != null 
        && request.auth.uid == resource.data.technicianId
        && isTechnicianApproved(request.auth.uid);
      allow delete: if request.auth != null 
        && (request.auth.uid == resource.data.technicianId || isAdmin());
    }
    
    // Other collections remain the same...
    match /customers/{customerId} {
      allow read, write: if request.auth != null && request.auth.uid == customerId;
    }
    
    match /bookings/{bookingId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.customerId || 
         request.auth.uid == resource.data.technicianId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.customerId;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.customerId || 
         request.auth.uid == resource.data.technicianId);
    }
    
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    
    match /coupons/{couponId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
    
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.customerId;
      allow update: if false; // Reviews are immutable
    }
    
    // Helper functions
    function isAdmin() {
      return request.auth.token.admin == true;
    }
    
    function validateTechnicianUpdate(before, after) {
      // Technicians can update their own profile but not approval status
      return !('profileApproved' in after.data.diff(before.data).affectedKeys()) &&
             !('profileApprovalRequested' in after.data.diff(before.data).affectedKeys()) &&
             !('profileRejected' in after.data.diff(before.data).affectedKeys());
    }
    
    function isApprovalStatusUpdate(before, after) {
      // Only allow admin to update approval status fields
      let changedKeys = after.data.diff(before.data).affectedKeys();
      return changedKeys.hasOnly(['profileApproved', 'profileApprovalRequested', 'profileRejected', 'approvedAt', 'rejectedAt', 'updatedAt']);
    }
    
    function isTechnicianApproved(uid) {
      // Check if technician profile is approved for service creation
      let technicianDoc = get(/databases/$(database)/documents/technicians/$(uid));
      return technicianDoc.data.profileApproved == true && 
             calculateProfileCompletion(technicianDoc.data) == 100;
    }
    
    function calculateProfileCompletion(technician) {
      // Simplified profile completion check for Firestore rules
      let completed = 0;
      let total = 8;
      
      if ('fullName' in technician && technician.fullName != '') completed = completed + 1;
      if ('phone' in technician && technician.phone != '') completed = completed + 1;
      if ('profilePhotoUrl' in technician && technician.profilePhotoUrl != '') completed = completed + 1;
      if ('skills' in technician && technician.skills.size() > 0) completed = completed + 1;
      if ('experienceYears' in technician && technician.experienceYears > 0) completed = completed + 1;
      if ('bankStatus' in technician && technician.bankStatus == 'approved') completed = completed + 1;
      if (('aadhaarFrontUrl' in technician && technician.aadhaarFrontUrl != '') || 
          ('panNumber' in technician && technician.panNumber != '')) completed = completed + 1;
      if (('customServices' in technician && technician.customServices.size() > 0) || 
          ('skills' in technician && technician.skills.size() > 0)) completed = completed + 1;
      
      return math.round((completed * 100) / total);
    }
  }
}