rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Custom request images - authenticated users only
    match /custom_requests/{requestId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Service images - authenticated users only
    match /services/{serviceId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // CRITICAL FIX: Technician service images - PUBLIC READ for customer app
    // Path: technicians/{technicianId}/services/{imageFile}
    match /technicians/{technicianId}/services/{imageFile} {
      // Allow public read so customers can see service images
      allow read: if true;
      // Only the technician can upload their service images
      allow write: if request.auth != null
                   && request.auth.uid == technicianId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

