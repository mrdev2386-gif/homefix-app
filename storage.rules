rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }
    
    function isSmallFile() {
      return request.resource.size < 5 * 1024 * 1024;
    }
    
    function isLargeFile() {
      return request.resource.size < 100 * 1024 * 1024;
    }
    
    // Metadata bound to real user - prevents spoofing
    function hasValidMetadata() {
      return request.resource.metadata.userId == request.auth.uid &&
             request.resource.metadata.keys.hasAll(['uploadedAt', 'userId']);
    }
    
    // KYC file validation - only allow images or PDFs
    function isAllowedKycFile() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType == 'application/pdf';
    }
    
    // Metadata owner binding - prevent spoofing
    function isMetadataOwner() {
      return request.resource.metadata.ownerId == request.auth.uid;
    }
    
    // Booking participant validation
    function isBookingParticipant() {
      return request.resource.metadata.customerId == request.auth.uid ||
             request.resource.metadata.technicianId == request.auth.uid;
    }
    
    // ==========================================
    // USER STORAGE (Profile images)
    // ==========================================
    
    // Users/{userId}/profile/** - owner write, public read for profile display
    match /users/{userId}/profile/{fileName} {
      allow read: if true;  // Public read for profile display
      allow write: if isSignedIn() && isOwner(userId) && isImage() && isSmallFile();
    }
    
    match /users/{userId}/profile.jpg {
      allow read: if true;  // Public read for profile display
      allow write: if isSignedIn() && isOwner(userId) && isImage() && isSmallFile();
    }
    
    // Customers/{userId}/** - owner only
    match /customers/{userId}/{fileName} {
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if isSignedIn() && isOwner(userId) && isImage() && isSmallFile();
    }
    
    // Users legacy
    match /users/{userId}/{fileName} {
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if isSignedIn() && isOwner(userId) && isImage() && isSmallFile();
    }
    
    // ==========================================
    // TECHNICIAN STORAGE
    // ==========================================
    
    // Technicians/{userId}/** - owner write, authenticated read
    match /technicians/{techId}/{allPaths=**} {
      allow read: if isSignedIn();  // Authenticated read
      allow write: if isSignedIn() && isOwner(techId);
    }
    
    // Technician docs - owner only
    match /technician_docs/{techId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(techId) && isSmallFile();
    }
    
    // ==========================================
    // PROFESSIONAL REELS (Public Read)
    // ==========================================
    
    match /reels/{techId}/{fileName} {
      allow read: if true;  // Public read
      allow write: if isSignedIn() && isOwner(techId) && isVideo() && isLargeFile();
    }
    
    // ==========================================
    // SUPPORT IMAGES
    // ==========================================
    
    match /support/{ticketId}/{fileName} {
      allow read: if isSignedIn() && (
        (resource.metadata.keys.hasAny(['ownerId']) &&
         resource.metadata.ownerId == request.auth.uid) ||
        isAdmin()
      );
      allow write: if isSignedIn() 
        && isMetadataOwner()
        && isImage() 
        && isSmallFile();
    }
    
    // ==========================================
    // SERVICE IMAGES (Admin Only Write)
    // ==========================================
    
    match /services/{serviceId}/{fileName} {
      allow read: if true;  // Public read for service catalog
      allow write: if isSignedIn() && isAdmin() && isImage() && isSmallFile();
    }
    
    match /categories/{categoryId}/{fileName} {
      allow read: if true;  // Public read
      allow write: if isSignedIn() && isAdmin() && isImage() && isSmallFile();
    }
    
    match /subServices/{subServiceId}/{fileName} {
      allow read: if true;  // Public read
      allow write: if isSignedIn() && isAdmin() && isImage() && isSmallFile();
    }
    
    // ==========================================
    // BANNER IMAGES
    // ==========================================
    
    match /banners/{fileName} {
      allow read: if true;  // Public read
      allow write: if isSignedIn() && isAdmin() && isImage() && isSmallFile();
    }
    
    // ==========================================
    // BOOKING IMAGES
    // ==========================================
    
    match /bookings/{bookingId}/{fileName} {
      allow read: if isSignedIn() && (
        (resource.metadata.keys.hasAny(['customerId']) &&
         resource.metadata.customerId == request.auth.uid) ||
        (resource.metadata.keys.hasAny(['technicianId']) &&
         resource.metadata.technicianId == request.auth.uid) ||
        isAdmin()
      );
      allow write: if isSignedIn() 
        && isBookingParticipant()
        && isImage() 
        && isSmallFile();
    }
    
    // ==========================================
    // CUSTOM REQUEST IMAGES
    // ==========================================
    
    match /custom_requests/{customerId}/{requestId}/{fileName} {
      allow read: if isSignedIn() && (
        resource.metadata.customerId == request.auth.uid ||
        resource.metadata.technicianId == request.auth.uid ||
        isAdmin()
      );
      // Cloud Functions write only - client uploads via base64 in callable function
      allow write: if false;
    }

    // ==========================================
    // DENY ALL UNSPECIFIED PATHS
    // ==========================================
    
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
