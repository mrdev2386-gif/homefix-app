rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Custom Requests Collection
    match /custom_requests/{requestId} {
      // Customer can read own requests
      allow read: if request.auth.uid == resource.data.customerId;
      
      // Technician can read assigned requests
      allow read: if request.auth.uid == resource.data.technicianId;
      
      // Admin can read all requests
      allow read: if request.auth.token.admin == true;
      
      // No direct writes - only via Cloud Functions
      allow write: if false;
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      // Customer can read own bookings
      allow read: if request.auth.uid == resource.data.customerId;
      
      // Technician can read assigned bookings
      allow read: if request.auth.uid == resource.data.technicianId;
      
      // No direct writes - only via Cloud Functions
      allow write: if false;
    }

    // Users Collection
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
      
      // Addresses Subcollection
      match /addresses/{addressId} {
        allow read, write: if request.auth.uid == uid;
      }
    }

    // Technicians Collection
    match /technicians/{uid} {
      allow read: if true;
      allow write: if request.auth.uid == uid;
    }
  }
}

/*
REQUIRED FIRESTORE INDEXES:

1. Collection: custom_requests
   Fields: status (Ascending), createdAt (Descending)
   
2. Collection: custom_requests
   Fields: customerId (Ascending), createdAt (Descending)
   
3. Collection: custom_requests
   Fields: technicianId (Ascending), status (Ascending)

Create these indexes in Firebase Console:
- Firestore Database > Indexes > Create Index
*/
