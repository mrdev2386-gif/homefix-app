rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.admin == true;
    }
    
    // ==========================================
    // PUBLIC CATALOGS (Read-only, no auth required)
    // ==========================================
    
    // Home banners - public read for app display
    match /home_banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /service_bottom_banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /celebrating_professionals/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /cleaning_essentials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /service_spotlight/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Technician categories - public read for partner onboarding
    match /technician_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Technician subcategories - public read for partner onboarding
    match /technician_subcategories/{subCategoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Services - public read for service catalog
    
    // Home Sections - Dynamic home screen control
    match /homeSections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Categories - public read
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
      
      // Explicit match for active services under a category
      match /services/{serviceId} {
        allow read: if (resource.data.isActive == true) || isAdmin();
        allow write: if isAdmin();
        
        // SubServices - explicit path match with strict active check
        match /subServices/{subId} {
          allow read: if (resource.data.isActive == true) || isAdmin();
          allow write: if isAdmin();
        }
      }
    }

    // Collection Group: services
    // Allows querying all services globally where isActive == true
    match /{path=**}/services/{serviceId} {
      allow read: if (resource.data.isActive == true) || isAdmin();
      allow write: if false;
    }

    // Collection Group: subServices
    // Allows querying all subServices globally where isActive == true
    match /{path=**}/subServices/{subId} {
      allow read: if (resource.data.isActive == true) || isAdmin();
      allow write: if false;
    }
    
    // Coupons - public read
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // System Status - public read
    match /systemStatus/{statusId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Notifications - read only by owner, write only via Cloud Functions
    match /notifications/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false; // writes only via Cloud Functions
    }
    
    // ==========================================
    // TECHNICIANS (Public read only, writes via Cloud Functions)
    // ==========================================
    
    // ==========================================
    // TECHNICIAN SERVICES (Single Source of Truth)
    // ==========================================
    
    // Technician Services - Nested under technicians collection
    // Path: technicians/{technicianId}/services/{serviceId}
    match /technicians/{technicianId} {
      // Public read for finding technicians
      allow read: if true;
      
      // WRITE: ONLY via Cloud Functions - no direct client writes allowed
      allow write: if false;
      
      // Services subcollection - SINGLE SOURCE OF TRUTH
      match /services/{serviceId} {
        // Read: Public for active services, owner for own services, admin for all
        allow read: if (resource.data.isActive == true && resource.data.isDeleted == false) || 
                    isAdmin() || 
                    (isAuthenticated() && technicianId == request.auth.uid);
        
        // Write: ONLY via Cloud Functions
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
      
      // Subcollections
      match /earnings/{earningId} {
        allow read: if isOwner(technicianId) || isAdmin();
        allow write: if false; // Only Cloud Functions
      }
      
      match /ledger/{entryId} {
        allow read: if isOwner(technicianId) || isAdmin();
        allow write: if false; // Only Cloud Functions
      }
    }
    
    // ==========================================
    // USERS COLLECTION (Role management)
    // ==========================================
    
    match /users/{userId} {
      // User can read their own profile
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile (initial login)
      // But role can only be set by Cloud Functions
      allow create: if isOwner(userId) && (
        !request.resource.data.keys().hasAny(['role']) ||
        request.resource.data.role == null
      );
      
      // Update: Only allow updating non-role fields
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
      
      allow delete: if false;
    }
    
    // ==========================================
    // AUTHENTICATED USERS
    // ==========================================
    
    // Customers
    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create: if isOwner(customerId);
      allow update: if isOwner(customerId) && (
        !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['walletBalance', 'isSuspended', 'referralCode', 'referredBy', 'isApproved'])
      );
      allow delete: if false;
      
      match /cart/{cartItemId} {
        allow read: if isOwner(customerId);
        allow write: if isOwner(customerId);
      }
      
      // Favorites - user can only read/write their own favorites
      match /favorites/{favoriteId} {
        allow read: if isOwner(customerId);
        allow write: if isOwner(customerId);
      }
      
      match /addresses/{addressId} {
        allow read: if isOwner(customerId);
        allow write: if isOwner(customerId);
      }
    }
    
    // FCM TOKENS (Both Apps)
    match /fcmTokens/{tokenId} {
      allow read: if isAuthenticated();
      // Safe write: only owner can update their own token doc
      allow write: if isAuthenticated() && (
        !resource.exists || resource.data.userId == request.auth.uid
      ) && (
        !request.resource.data.keys().hasAny(['userId']) || 
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      // Read: Admin, customer (owner), or assigned technician
      allow read: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.customerID ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.uid ||
        request.auth.uid == resource.data.technicianId ||
        request.auth.uid == resource.data.assignedTechnicianId
      );
      // Write: Only via Cloud Functions (no direct client writes)
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Idempotency Tracking
    match /booking_idempotency/{id} {
      // id is customerId_key
      allow read: if isAuthenticated() && (isAdmin() || id.startsWith(request.auth.uid));
      allow write: if false; // Only Cloud Functions
    }
    
    // ==========================================
    // REVIEWS
    // ==========================================
    
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow write: if false; // Writes only via submitServiceRating Cloud Function
    }
    
    // ==========================================
    // BOOKING REQUESTS
    // ==========================================
    
    match /bookingRequests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.keys.hasAny(['customerId']) && 
         resource.data.customerId == request.auth.uid)
      );
      allow write: if false; // Writes only via createBookingRequest Cloud Function
    }
    
    // Assignment Requests
    match /assignment_requests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.keys.hasAny(['technicianId']) && 
         resource.data.technicianId == request.auth.uid)
      );
      allow write: if false;
    }
    
    // ==========================================
    // PARTNER ONBOARDING
    // ==========================================
    
    // Partner Applications
    match /partner_applications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }
    
    // Technician Applications
    match /technicianApplications/{applicationId} {
      allow read: if isAdmin() ||
        (resource.data.keys.hasAny(['userId']) &&
         resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && 
        request.resource.data.keys.hasAny(['userId']) &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }
    
    // ==========================================
    // PAYMENTS & FINANCIAL
    // ==========================================
    
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    
    // Technician Earnings & Payouts
    match /technicianEarnings/{techId} {
      allow read: if isOwner(techId) || isAdmin();
      
      match /ledger/{entryId} {
        allow read: if isOwner(techId) || isAdmin();
        allow write: if false;
      }
    }
    
    match /payoutBatches/{batchId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // ==========================================
    // ADMIN ONLY
    // ==========================================
    
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Admin Logs - Only admin can read/write
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if isAdmin();
    }
    
    match /adminAlerts/{alertId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Rate Limits
    match /rateLimits/{limitId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    match /rateLimitWindows/{windowId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // Analytics
    match /analytics/{dayId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    match /events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // Failed Webhooks
    match /failedWebhooks/{webhookId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // Payout Integrity
    match /payoutIntegrityReports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // Risk Profiles
    match /risk_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
    
    // ==========================================
    // TECHNICIAN SERVICES (YouTube-style service listings)
    // ==========================================
    
    // Technician Services - All writes via Cloud Function, read varies
    // CRITICAL: Service management requires adminApproved == true
    match /technician_services/{serviceId} {
      // Read: Public for active services, owner for own services, admin for all
      // Note: resource.data is used for existing documents; for collection group queries,
      // we check the fields directly
      allow read: if (resource.data.isPublished == true && resource.data.technicianApproved == true) || 
                  isAdmin() || (isAuthenticated() && resource.data.technicianId == request.auth.uid);
      
      // Write: Only via Cloud Function (enforced by function), no direct write
      // Cloud Functions must verify technician has adminApproved == true before allowing writes
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    
    // Service Access Control - ensures technicians can only manage services after admin approval
    match /technician_service_access/{technicianId} {
      // Only the technician themselves or admin can read this
      allow read: if isOwner(technicianId) || isAdmin();
      // Write: Only via Cloud Function after admin approval
      allow write: if false;
    }
    
    // ==========================================
    // USER ACTIVITY
    // ==========================================
    
    match /userActivity/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId) || isAdmin();
      allow update: if false;
      allow delete: if false;
      
      match /logs/{logId} {
        allow read: if isAdmin() || isOwner(userId);
        allow write: if false;
      }
    }
    
    // ==========================================
    // SERVICE REQUESTS (CUSTOM REQUESTS)
    // ==========================================
    
    match /service_requests/{requestId} {
      // Read: Admin, owner (customer), or assigned technician
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.technicianId == request.auth.uid
      );
      // Write: ONLY via Cloud Functions
      allow write: if false;
    }
    
    // Idempotency Tracking for Service Requests
    match /request_idempotency/{id} {
      allow read: if isAuthenticated() && (isAdmin() || id.startsWith("custom_" + request.auth.uid));
      allow write: if false;
    }
    
    // Technician Notifications
    match /technician_notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.technicianId == request.auth.uid
      );
      allow write: if false;
    }

    // ==========================================
    // CHAT SYSTEM
    // ==========================================
    
    // Chats collection - stores chat metadata
    match /chats/{chatId} {
      // Only participants (customer or technician) can read
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.technicianId == request.auth.uid
      );
      
      // Only Cloud Functions can create/update (no direct client writes)
      allow create: if false;
      allow update: if false;
      allow delete: if false;
      
      // Messages subcollection
      match /messages/{messageId} {
        // Only chat participants can read
        allow read: if isAuthenticated() && (
          isAdmin() ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.technicianId == request.auth.uid
        );
        
        // Only Cloud Functions can write
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
    }

    // ==========================================
    // DENY ALL UNSPECIFIED PATHS
    // ==========================================
    
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
