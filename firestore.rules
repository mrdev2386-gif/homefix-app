rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isProtectedFieldModified(protectedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields);
    }

    // ==========================================
    // ADMINS COLLECTION
    // ==========================================

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ==========================================
    // CUSTOMERS COLLECTION
    // ==========================================

    match /customers/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && !isProtectedFieldModified([
          'walletBalance', 'referralCode', 'referralRewardClaimed',
          'isSuspended', 'suspendedAt', 'suspensionReason'
        ]);
      allow update: if isAdmin();
      allow delete: if false;

      match /cart/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /favorites/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /addresses/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /payment_methods/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /wallet_transactions/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /fcmTokens/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ==========================================
    // TECHNICIANS COLLECTION
    // ==========================================

    match /technicians/{technicianId} {
      allow read: if isOwner(technicianId) || isAdmin();
      allow create: if isOwner(technicianId);
      allow update: if isOwner(technicianId)
        && !isProtectedFieldModified([
          'verificationStatus', 'profileCompletion', 'approvedAt', 'approvedBy',
          'rejectionReason', 'isApproved', 'isKycComplete', 'kycSubmittedAt',
          'isSuspended', 'suspendedAt', 'suspendedBy', 'suspensionReason',
          'avgRating', 'totalRatings', 'totalJobs', 'walletBalance',
          'onboardingStep', 'isLocked', 'status', 'kycStatus', 
          'onboardingCompleted', 'role', 'adminApproved', 'earnings', 
          'jobsDone', 'blockedAt', 'adminNotes'
        ])
        && !(request.resource.data.verificationStatus == 'approved');
      allow update: if isAdmin();
      allow delete: if false;

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(technicianId);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(technicianId);
        allow write: if false;
      }
    }

    // ==========================================
    // TECHNICIAN SERVICES COLLECTION
    // ==========================================

    match /technician_services/{serviceId} {
      // Any authenticated user can read (needed for home screen, service discovery)
      allow read: if isSignedIn();

      // Technicians create via Cloud Function — no status check on client
      allow create: if isSignedIn()
        && request.resource.data.technicianId == request.auth.uid;

      // Technicians update their own non-moderation fields
      allow update: if isSignedIn()
        && resource.data.technicianId == request.auth.uid
        && !isProtectedFieldModified([
          'status', 'approvedAt', 'approvedBy', 'rejectedAt',
          'rejectedBy', 'rejectionReason', 'moderationNotes'
        ])
        && !(request.resource.data.status == 'approved');

      // Admins can update any field (moderation)
      allow update: if isAdmin();

      // Technicians delete their own pending/rejected services
      allow delete: if isSignedIn()
        && resource.data.technicianId == request.auth.uid
        && resource.data.status in ['pending', 'rejected'];

      allow delete: if isAdmin();
    }

    // ==========================================
    // BOOKINGS COLLECTION
    // ==========================================

    match /bookings/{bookingId} {
      allow read: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
            || resource.data.technicianId == request.auth.uid
            || isAdmin());

      // All writes go through Cloud Functions only (Admin SDK bypasses rules)
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ==========================================
    // CUSTOM REQUESTS COLLECTION
    // ==========================================

    match /custom_requests/{id} {
      allow read: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
            || resource.data.technicianId == request.auth.uid
            || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
            || resource.data.technicianId == request.auth.uid);
      allow delete: if false;
    }

    // ==========================================
    // SERVICE REQUESTS COLLECTION
    // ==========================================

    match /service_requests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
            || isAdmin()
            || (request.auth.token.role == 'technician'
                && request.auth.token.district == resource.data.district));
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.customerId == request.auth.uid
        && resource.data.status in ['pending', 'pending_admin'];
    }

    // ==========================================
    // WALLET SYSTEM
    // ==========================================

    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /walletTransactions/{txnId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ==========================================
    // TECHNICIAN WALLET SYSTEM
    // ==========================================

    match /technician_wallets/{technicianId} {
      allow read: if isOwner(technicianId) || isAdmin();
      allow write: if false;

      match /transactions/{txnId} {
        allow read: if isOwner(technicianId) || isAdmin();
        allow write: if false;
      }
    }

    // ==========================================
    // WITHDRAWAL REQUESTS COLLECTION
    // ==========================================

    match /withdrawal_requests/{requestId} {
      // Technicians can read their own requests
      allow read: if isSignedIn()
        && (resource.data.technicianId == request.auth.uid || isAdmin());

      // Technicians can create requests (via Cloud Function)
      // All writes go through Cloud Functions only
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ==========================================
    // SERVICE CATALOG (read-only for users)
    // ==========================================

    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ==========================================
    // REVIEWS COLLECTION
    // ==========================================

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if false;
    }

    // ==========================================
    // COUPONS COLLECTION
    // ==========================================

    match /coupons/{couponId} {
      allow read: if isSignedIn() && resource.data.isActive == true;
      allow write: if isAdmin();
    }

    // ==========================================
    // NOTIFICATIONS COLLECTION
    // ==========================================

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false;
    }

    // ==========================================
    // SUPPORT TICKETS COLLECTION
    // ==========================================

    match /support_tickets/{ticketId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ==========================================
    // REFERRALS COLLECTION
    // ==========================================

    match /referrals/{referralId} {
      allow read: if isSignedIn()
        && (resource.data.referrerId == request.auth.uid
            || resource.data.referredUserId == request.auth.uid);
      allow write: if false;
    }

    // ==========================================
    // DISPUTES COLLECTION
    // ==========================================

    match /disputes/{disputeId} {
      allow read: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
            || resource.data.technicianId == request.auth.uid
            || isAdmin());
      allow create: if isSignedIn()
        && (request.resource.data.customerId == request.auth.uid
            || request.resource.data.technicianId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ==========================================
    // DEFAULT DENY ALL
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
