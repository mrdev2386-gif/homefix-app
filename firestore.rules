rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isActive() {
      return !resource.data.keys.hasAny(['isActive']) || resource.data.isActive == true;
    }
    
    // ==========================================
    // PUBLIC CATALOGS (Read-only, no auth required)
    // ==========================================
    
    // Home banners - public read for app display
    match /home_banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /service_bottom_banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /celebrating_professionals/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /cleaning_essentials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /service_spotlight/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Technician categories - public read for partner onboarding
    match /technician_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Technician subcategories - public read for partner onboarding
    match /technician_subcategories/{subCategoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Services - public read for service catalog
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Categories - public read
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
      
      // SubServices under categories - public read for service catalog
      match /services/{serviceId}/subServices/{subId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    
    // Coupons - public read
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // System Status - public read
    match /systemStatus/{statusId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Notifications - public read for authenticated users
    match /notifications/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // ==========================================
    // TECHNICIANS (Public read only)
    // ==========================================
    
    match /technicians/{technicianId} {
      allow read: if true;
      allow write: if false;
      
      match /earnings/{earningId} {
        allow read: if isOwner(technicianId) || isAdmin();
        allow write: if false;
      }
      
      match /ledger/{entryId} {
        allow read: if isOwner(technicianId) || isAdmin();
        allow write: if false;
      }
    }
    
    // ==========================================
    // AUTHENTICATED USERS
    // ==========================================
    
    // Customers
    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow write: if isOwner(customerId) || isAdmin();
      
      match /cart/{cartItemId} {
        allow read: if isOwner(customerId);
        allow write: if isOwner(customerId);
      }
      
      // Favorites - user can only read/write their own favorites
      match /favorites/{favoriteId} {
        allow read: if isOwner(customerId);
        allow write: if isOwner(customerId);
      }
      
      match /addresses/{addressId} {
        allow read: if isOwner(customerId);
        allow write: if isOwner(customerId);
      }
      
      match /notifications/{notificationId} {
        allow read: if isOwner(customerId);
        allow write: if isAdmin();
      }
      
      // ==========================================
    // FCM TOKENS (Both Apps)
    // ==========================================
    
    match /fcmTokens/{tokenId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
  }
  
  // Users legacy
  match /users/{userId} {
    allow read: if isOwner(userId) || isAdmin();
    allow write: if isOwner(userId) || isAdmin();
  }
  
  // ==========================================
  // UNIFIED NOTIFICATIONS COLLECTION
  // ==========================================
  
  match /notifications/{notificationId} {
    // User can read only their own notifications
    allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    
    // Only Cloud Functions can create notifications
    allow create: if false;
    
    // User can update isRead for their own notifications
    allow update: if isAuthenticated() && 
      resource.data.userId == request.auth.uid &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
    
    // Only owner or admin can delete
    allow delete: if isAuthenticated() && 
      (resource.data.userId == request.auth.uid || isAdmin());
  }

  // Users legacy
  match /users/{userId} {
    allow read: if isOwner(userId) || isAdmin();
    allow write: if isOwner(userId) || isAdmin();
  }
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }
    
    // ==========================================
    // BOOKINGS
    // ==========================================
    
    match /bookings/{bookingId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.customerID ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.uid
      );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    
    // ==========================================
    // REVIEWS
    // ==========================================
    
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.keys.hasAny(['customerId']) &&
        request.resource.data.customerId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // BOOKING REQUESTS
    // ==========================================
    
    match /bookingRequests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.keys.hasAny(['customerId']) && 
         resource.data.customerId == request.auth.uid)
      );
      allow create: if isAuthenticated() && 
        request.resource.data.keys.hasAny(['customerId']) &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'processing';
      allow update: if false;
      allow delete: if false;
    }
    
    // Assignment Requests
    match /assignment_requests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.keys.hasAny(['technicianId']) && 
         resource.data.technicianId == request.auth.uid)
      );
      allow write: if false;
    }
    
    // ==========================================
    // PARTNER ONBOARDING
    // ==========================================
    
    // Partner Applications
    match /partner_applications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }
    
    // Technician Applications
    match /technicianApplications/{applicationId} {
      allow read: if isAdmin() ||
        (resource.data.keys.hasAny(['userId']) &&
         resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && 
        request.resource.data.keys.hasAny(['userId']) &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }
    
    // ==========================================
    // PAYMENTS & FINANCIAL
    // ==========================================
    
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    
    // Technician Earnings & Payouts
    match /technicianEarnings/{techId} {
      allow read: if isOwner(techId) || isAdmin();
      
      match /ledger/{entryId} {
        allow read: if isOwner(techId) || isAdmin();
        allow write: if false;
      }
    }
    
    match /payoutBatches/{batchId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // ==========================================
    // ADMIN ONLY
    // ==========================================
    
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if isAdmin();
    }
    
    match /adminAlerts/{alertId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Rate Limits
    match /rateLimits/{limitId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    match /rateLimitWindows/{windowId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // Analytics
    match /analytics/{dayId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    match /events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // Failed Webhooks
    match /failedWebhooks/{webhookId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // Payout Integrity
    match /payoutIntegrityReports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // Risk Profiles
    match /risk_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
    
    // ==========================================
    // USER ACTIVITY
    // ==========================================
    
    match /userActivity/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId) || isAdmin();
      allow update: if false;
      allow delete: if false;
      
      match /logs/{logId} {
        allow read: if isAdmin() || isOwner(userId);
        allow write: if false;
      }
    }
    
    // ==========================================
    // CUSTOM REQUESTS
    // ==========================================
    
    match /custom_requests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.technicianAssigned == request.auth.uid
      );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    
    // Technician Notifications
    match /technician_notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.technicianId == request.auth.uid
      );
      allow write: if false;
    }

    // ==========================================
    // CHAT SYSTEM
    // ==========================================
    
    // Chats collection - stores chat metadata
    match /chats/{chatId} {
      // Only participants (customer or technician) can read
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.technicianId == request.auth.uid
      );
      
      // Only Cloud Functions can create/update (no direct client writes)
      allow create: if false;
      allow update: if false;
      allow delete: if false;
      
      // Messages subcollection
      match /messages/{messageId} {
        // Only chat participants can read
        allow read: if isAuthenticated() && (
          isAdmin() ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.technicianId == request.auth.uid
        );
        
        // Only Cloud Functions can write
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
    }

    // ==========================================
    // DENY ALL UNSPECIFIED PATHS
    // ==========================================
    
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
