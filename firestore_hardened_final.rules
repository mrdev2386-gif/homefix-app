rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // ==========================================
    // FIX 4: HARDENED BACKEND COLLECTIONS
    // ==========================================
    
    // Booking idempotency - Cloud Functions ONLY
    match /booking_idempotency/{key} {
      allow read, write: if false; // Functions only via Admin SDK
    }
    
    // Rate limits - Cloud Functions ONLY
    match /rate_limits/{windowId} {
      allow read, write: if false; // Functions only via Admin SDK
    }
    
    // Abuse logs - Admin read only
    match /abuse_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Functions only
    }
    
    // Admin alerts - Admin read only
    match /admin_alerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false; // Functions only
    }
    
    // Suspicious wallets - Admin read only
    match /suspicious_wallets/{techId} {
      allow read: if isAdmin();
      allow write: if false; // Functions only
    }
    
    // ==========================================
    // FIX 4: HARDENED BOOKINGS
    // ==========================================
    
    match /bookings/{bookingId} {
      // Read: Admin, customer (owner), or assigned technician
      allow read: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.technicianId
      );
      
      // Write: ONLY via Cloud Functions - NO direct client writes
      // This prevents:
      // - Price manipulation
      // - Status manipulation
      // - Unauthorized booking changes
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    
    // ==========================================
    // FIX 4: HARDENED WALLETS
    // ==========================================
    
    // Technician wallets - NO client writes EVER
    match /technician_wallets/{techId} {
      // Read: Only owner or admin
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == techId);
      
      // Write: NEVER via client - only Cloud Functions
      // This prevents:
      // - Balance manipulation
      // - Unauthorized credits
      // - Wallet corruption
      allow create: if false;
      allow update: if false;
      allow delete: if false;
      
      // Transactions subcollection - Read only
      match /transactions/{txnId} {
        allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == techId);
        allow write: if false; // Functions only
      }
    }
    
    // ==========================================
    // TECHNICIANS
    // ==========================================
    
    match /technicians/{technicianId} {
      // Public read for finding technicians
      allow read: if true;
      
      // Write: ONLY via Cloud Functions for critical fields
      // Allow technician to update non-critical fields only
      allow update: if isOwner(technicianId) && (
        // Only allow updating these safe fields
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['walletBalance', 'isApproved', 'adminApproved', 'rating', 'jobsCompleted'])
      );
      
      allow create, delete: if false;
      
      // Services subcollection
      match /services/{serviceId} {
        allow read: if (resource.data.isActive == true && resource.data.isDeleted == false) || 
                    isAdmin() || 
                    (isAuthenticated() && technicianId == request.auth.uid);
        
        // Write: ONLY via Cloud Functions
        allow create, update, delete: if false;
      }
      
      // Earnings subcollection
      match /earnings/{earningId} {
        allow read: if isOwner(technicianId) || isAdmin();
        allow write: if false; // Functions only
      }
      
      // Ledger subcollection
      match /ledger/{entryId} {
        allow read: if isOwner(technicianId) || isAdmin();
        allow write: if false; // Functions only
      }
    }
    
    // ==========================================
    // CUSTOMERS
    // ==========================================
    
    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create: if isOwner(customerId);
      
      // Prevent wallet balance manipulation
      allow update: if isOwner(customerId) && (
        !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['walletBalance', 'isSuspended', 'referralCode', 'referredBy', 'isApproved'])
      );
      
      allow delete: if false;
      
      match /addresses/{addressId} {
        allow read: if isOwner(customerId);
        allow write: if isOwner(customerId);
      }
      
      match /cart/{cartItemId} {
        allow read: if isOwner(customerId);
        allow write: if isOwner(customerId);
      }
      
      match /favorites/{favoriteId} {
        allow read: if isOwner(customerId);
        allow write: if isOwner(customerId);
      }
    }
    
    // ==========================================
    // PUBLIC CATALOGS
    // ==========================================
    
    match /home_banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /service_bottom_banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /celebrating_professionals/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /cleaning_essentials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /service_spotlight/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /technician_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /technician_subcategories/{subCategoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /homeSections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /services/{serviceId} {
        allow read: if (resource.data.isActive == true) || isAdmin();
        allow write: if isAdmin();
        
        match /subServices/{subId} {
          allow read: if (resource.data.isActive == true) || isAdmin();
          allow write: if isAdmin();
        }
      }
    }
    
    match /{path=**}/services/{serviceId} {
      allow read: if (resource.data.isActive == true) || isAdmin();
      allow write: if false;
    }
    
    match /{path=**}/subServices/{subId} {
      allow read: if (resource.data.isActive == true) || isAdmin();
      allow write: if false;
    }
    
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /systemStatus/{statusId} {
      allow read: if true;
      allow write: if false;
    }
    
    // ==========================================
    // NOTIFICATIONS
    // ==========================================
    
    match /notifications/{docId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow write: if false; // Functions only
    }
    
    // ==========================================
    // FCM TOKENS
    // ==========================================
    
    match /fcmTokens/{tokenId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        !resource.exists || resource.data.userId == request.auth.uid
      ) && (
        !request.resource.data.keys().hasAny(['userId']) || 
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ==========================================
    // REVIEWS
    // ==========================================
    
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow write: if false; // Functions only
    }
    
    // ==========================================
    // PAYMENTS & FINANCIAL
    // ==========================================
    
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false; // Functions only
    }
    
    match /payment_idempotency/{paymentId} {
      allow read, write: if false; // Functions only
    }
    
    match /payment_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Functions only
    }
    
    match /technicianEarnings/{techId} {
      allow read: if isOwner(techId) || isAdmin();
      
      match /ledger/{entryId} {
        allow read: if isOwner(techId) || isAdmin();
        allow write: if false;
      }
    }
    
    match /payoutBatches/{batchId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // ==========================================
    // ADMIN ONLY
    // ==========================================
    
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if isAdmin();
    }
    
    match /adminAlerts/{alertId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /rateLimits/{limitId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    match /rateLimitWindows/{windowId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    match /analytics/{dayId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    match /events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    match /failedWebhooks/{webhookId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    match /payoutIntegrityReports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    match /risk_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
    
    // ==========================================
    // USERS COLLECTION
    // ==========================================
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) && (
        !request.resource.data.keys().hasAny(['role']) ||
        request.resource.data.role == null
      );
      
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
      
      allow delete: if false;
    }
    
    // ==========================================
    // PARTNER ONBOARDING
    // ==========================================
    
    match /partner_applications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }
    
    match /technicianApplications/{applicationId} {
      allow read: if isAdmin() ||
        (resource.data.keys.hasAny(['userId']) &&
         resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && 
        request.resource.data.keys.hasAny(['userId']) &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }
    
    // ==========================================
    // BOOKING REQUESTS
    // ==========================================
    
    match /bookingRequests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.keys.hasAny(['customerId']) && 
         resource.data.customerId == request.auth.uid)
      );
      allow write: if false; // Functions only
    }
    
    match /assignment_requests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.keys.hasAny(['technicianId']) && 
         resource.data.technicianId == request.auth.uid)
      );
      allow write: if false;
    }
    
    // ==========================================
    // SERVICE REQUESTS
    // ==========================================
    
    match /service_requests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.technicianId == request.auth.uid
      );
      allow write: if false; // Functions only
    }
    
    match /request_idempotency/{id} {
      allow read: if isAuthenticated() && (isAdmin() || id.startsWith("custom_" + request.auth.uid));
      allow write: if false;
    }
    
    match /technician_notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.technicianId == request.auth.uid
      );
      allow write: if false;
    }
    
    // ==========================================
    // CHAT SYSTEM
    // ==========================================
    
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.technicianId == request.auth.uid
      );
      
      allow create, update, delete: if false; // Functions only
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          isAdmin() ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.technicianId == request.auth.uid
        );
        
        allow create, update, delete: if false; // Functions only
      }
    }
    
    // ==========================================
    // TECHNICIAN SERVICES
    // ==========================================
    
    match /technician_services/{serviceId} {
      allow read: if (resource.data.isPublished == true && resource.data.technicianApproved == true) || 
                  isAdmin() || (isAuthenticated() && resource.data.technicianId == request.auth.uid);
      
      allow create, update, delete: if false; // Functions only
    }
    
    match /technician_service_access/{technicianId} {
      allow read: if isOwner(technicianId) || isAdmin();
      allow write: if false; // Functions only
    }
    
    // ==========================================
    // USER ACTIVITY
    // ==========================================
    
    match /userActivity/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId) || isAdmin();
      allow update, delete: if false;
      
      match /logs/{logId} {
        allow read: if isAdmin() || isOwner(userId);
        allow write: if false;
      }
    }
    
    // ==========================================
    // TECHNICIAN PAYOUTS
    // ==========================================
    
    match /technician_payouts/{payoutId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.technicianId == request.auth.uid
      );
      allow write: if false; // Functions only
    }
    
    match /technician_bank_accounts/{accountId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.technicianId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.technicianId;
      allow update, delete: if false;
    }
    
    match /reconciliation_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false; // Functions only
    }
    
    match /wallet_review_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    
    // ==========================================
    // DENY ALL UNSPECIFIED PATHS
    // ==========================================
    
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
